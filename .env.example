# 형식만 공유합니다 — 값은 자리표시자입니다. 실제 키를 여기 넣지 마세요.

# GPT 호출용
OPENAI_API_KEY=YOUR_KEY

# Firestore 서비스 계정 — JSON 파일 내용을 한 줄로 넣습니다(권장)
FIREBASE_SERVICE_ACCOUNT_JSON={"type":"service_account","project_id":"YOUR_PROJECT","private_key":"YOUR_KEY"}

# 또는 파일 경로 방식(로컬 개발용)
# FIREBASE_SERVICE_ACCOUNT_PATH=./serviceAccountKey.json

# CORS 허용 도메인(쉼표 구분). 프론트 배포 주소를 넣습니다.
ALLOWED_ORIGINS=http://localhost:5500,https://YOUR-PROJECT.vercel.app
